APP_NAME=GATE Intelligence
APP_ENV=development
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql+psycopg://gate_user:gate_pass@localhost:5432/gate_intelligence
SQLITE_FALLBACK_URL=sqlite:///./storage/gate_intelligence.db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=change-this-in-production-use-64-byte-hex-secret-key-0123456789abcdef
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_VERSION=v1-minilm-l6-384
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
TEMP_DIR=storage/temp
VISUAL_ASSETS_DIR=storage/visual_assets
MAX_UPLOAD_SIZE_MB=50
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
WORKER_CONCURRENCY=2
RATE_LIMIT_PER_MINUTE=120
ENABLE_OCR_FALLBACK=true
